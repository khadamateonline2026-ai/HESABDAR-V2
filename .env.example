# --- Core ---
# Neon / Supabase / any Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth (required in production)
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://your-app.vercel.app
VITE_AUTH_ENABLED=true

# Public app URL (same as BETTER_AUTH_URL usually)
APP_URL=https://your-app.vercel.app

# --- Email (Resend) for role-reset / verification ---
RESEND_API_KEY=re_xxxxxxxx
ROLE_MAIL_FROM=HESABDAR <noreply@yourdomain.com>
EMAIL_FROM=HESABDAR <noreply@yourdomain.com>

# --- Optional Grok / OAuth broker (leave empty for email/password-only) ---
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# Preview-only aliases (never commit real values)
GROK_PREVIEW_CLIENT_ID=
GROK_PREVIEW_CLIENT_SECRET=

# Local / PGLite (omit DATABASE_URL to use embedded DB in preview)
# VITE_AUTH_ENABLED=false
